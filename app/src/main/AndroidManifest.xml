<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== PERMISSIONS ===== -->

    <!-- Báo thức chính xác (quan trọng nhất) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions"/>

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Rung -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Full-screen intent (màn hình khóa) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Camera (quét QR) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Pedometer / Activity recognition -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <!-- Lưu file ảnh QR -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- Đọc nhạc chuông người dùng chọn (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartAlarm">

        <!-- ===== ACTIVITIES ===== -->

        <!-- MainActivity – màn hình chính -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- EditAlarmActivity – tạo/sửa báo thức -->
        <activity
            android:name=".ui.edit.EditAlarmActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"/>

        <!-- RingActivity – màn hình reo báo thức (hiển thị trên lock screen) -->
        <activity
            android:name=".ui.ring.RingActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"/>

        <!-- Challenge Activities -->
        <activity
            android:name=".ui.challenge.MathChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <activity
            android:name=".ui.challenge.ShakeChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <activity
            android:name=".ui.challenge.SquatChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <activity
            android:name=".ui.challenge.StepChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <activity
            android:name=".ui.challenge.QrChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartAlarm.FullScreen"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!-- QR Generator -->
        <activity
            android:name=".ui.qr.QrGeneratorActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ===== SERVICES ===== -->

        <!-- AlarmRingingService – foreground service phát nhạc -->
        <service
            android:name=".service.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- ===== RECEIVERS ===== -->

        <!-- AlarmReceiver – nhận trigger/snooze/dismiss từ AlarmManager -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.smartalarm.TRIGGER"/>
                <action android:name="com.example.smartalarm.SNOOZE"/>
                <action android:name="com.example.smartalarm.DISMISS"/>
                <action android:name="com.example.smartalarm.DISABLE"/>
                <action android:name="com.example.smartalarm.SKIP_ONCE"/>
            </intent-filter>
        </receiver>

        <!-- UpcomingReceiver – hiển thị thông báo trước 30 phút -->
        <receiver
            android:name=".service.UpcomingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.smartalarm.ACTION_UPCOMING"/>
            </intent-filter>
        </receiver>

        <!-- BootReceiver – khôi phục báo thức sau reboot/đổi giờ -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

    </application>

</manifest>