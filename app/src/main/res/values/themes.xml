<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day chip dùng trong item_alarm.xml -->
    <style name="DayChip">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/day_inactive_text</item>
        <item name="android:background">@drawable/bg_day_chip</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <!-- Day chip lớn hơn cho EditAlarmActivity -->
    <style name="DayChipLarge">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/day_inactive_text</item>
        <item name="android:background">@drawable/bg_day_chip</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <!-- Base app theme - DayNight for light/dark mode support -->
    <style name="Base.Theme.SmartAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/AlertDialog.SmartAlarm</item>
        <!-- Brand colors -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent_light</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>

        <!-- Window animation -->
        <item name="android:windowAnimationStyle">@style/WindowAnimations</item>
    </style>

    <style name="Theme.SmartAlarm" parent="Base.Theme.SmartAlarm" />

    <!-- Full screen theme (dùng cho RingActivity và ChallengeActivities) -->
    <style name="Theme.SmartAlarm.FullScreen" parent="Base.Theme.SmartAlarm">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Dialog (MaterialAlertDialogBuilder dùng overlay này qua materialAlertDialogTheme) -->
    <style name="AlertDialog.SmartAlarm" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_dialog</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SmartAlarm.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AlertDialog.SmartAlarm.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AlertDialog.SmartAlarm.Body</item>
    </style>

    <style name="ShapeAppearance.SmartAlarm.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="AlertDialog.SmartAlarm.Title"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="AlertDialog.SmartAlarm.Body"
        parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Window transition animations -->
    <style name="WindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Card style -->
    <style name="AlarmCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingTop">12dp</item>
        <item name="contentPaddingBottom">12dp</item>
    </style>

    <!--
      Nút preset hẹn giờ. MaterialButton mặc định có minWidth ~88dp và inset hai bên,
      4 nút cạnh nhau sẽ vượt chiều ngang màn hình và nhãn bị cắt còn "3".
    -->
    <!-- Chọn nhanh kiểu lặp trong màn hình sửa báo thức -->
    <style name="RepeatPreset" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">19dp</item>
    </style>

    <style name="TimerPreset" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="strokeColor">@color/accent</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAlarmTime">
        <item name="android:textSize">52sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAlarmLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextSectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>