<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_bg">

    <!-- Pulse animation background (lớp sau cùng) -->
    <View
        android:id="@+id/pulseView"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_pulse"
        android:alpha="0.3"/>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Label báo thức -->
        <TextView
            android:id="@+id/tvRingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <!-- Giờ hiển thị lớn -->
        <TextView
            android:id="@+id/tvRingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="80sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="0.02"/>

        <!-- Ngày tháng -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="80dp"/>

        <!-- Nút Snooze (có thể ẩn) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="Hoãn 5 phút"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border"
            android:layout_marginBottom="16dp"
            app:cornerRadius="28dp"/>

        <!-- Nút Thức dậy (dismiss hoặc bắt đầu challenge) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="@string/ring_dismiss"
            android:backgroundTint="@color/accent"
            android:textColor="@color/text_primary"
            app:cornerRadius="28dp"/>

    </LinearLayout>

</FrameLayout>
