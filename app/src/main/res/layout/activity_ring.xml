<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_bg">

    <!-- Pulse layers -->
    <View
        android:id="@+id/pulseView"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_pulse"
        android:alpha="0.18"/>

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ring_pulse"
        android:alpha="0.10"/>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top spacer -->
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Label -->
        <TextView
            android:id="@+id/tvRingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"/>

        <!-- Giờ lớn -->
        <TextView
            android:id="@+id/tvRingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="88sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="-0.02"/>

        <!-- Ngày tháng -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>

        <!-- Bottom spacer -->
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Snooze -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:text="Hoãn 5 phút"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/border"
            android:layout_marginBottom="14dp"
            app:cornerRadius="27dp"/>

        <!-- Dismiss -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:text="@string/ring_dismiss"
            android:textSize="17sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="56dp"
            app:cornerRadius="30dp"/>

    </LinearLayout>

</FrameLayout>
