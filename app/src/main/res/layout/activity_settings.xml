<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/bg_primary"
        app:navigationIcon="@drawable/ic_dismiss" android:title="@string/settings_title"
        app:titleTextColor="@color/text_primary"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="32dp">

            <!-- Section: Giao diện -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_display" style="@style/TextSectionHeader"
                android:layout_marginBottom="8dp" android:layout_marginTop="20dp"/>

            <!-- Theme selector -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/bg_card" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                android:layout_marginBottom="2dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    android:textColor="@color/text_primary" android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Tối -->
                    <LinearLayout android:id="@+id/btnThemeDark"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center"
                        android:background="@drawable/bg_challenge_card_selected"
                        android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tvThemeDark"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/settings_theme_dark"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Sáng -->
                    <LinearLayout android:id="@+id/btnThemeLight"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center"
                        android:background="@drawable/bg_challenge_card"
                        android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tvThemeLight"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/settings_theme_light"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Hệ thống -->
                    <LinearLayout android:id="@+id/btnThemeSystem"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center"
                        android:background="@drawable/bg_challenge_card">
                        <TextView android:id="@+id/tvThemeSystem"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/settings_theme_system"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Language selector -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/bg_card" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                android:layout_marginTop="2dp" android:layout_marginBottom="2dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_language"
                    android:textColor="@color/text_primary" android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/btnLangVi"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center"
                        android:background="@drawable/bg_challenge_card_selected"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tiếng Việt"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnLangEn"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center"
                        android:background="@drawable/bg_challenge_card">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="English"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Báo thức -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_alarm" style="@style/TextSectionHeader"
                android:layout_marginBottom="8dp" android:layout_marginTop="20dp"/>

            <!-- Snooze toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:background="@color/bg_card" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:layout_marginBottom="2dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_snooze_enabled"
                        android:textColor="@color/text_primary" android:textSize="16sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_snooze_enabled_desc"
                        android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSnooze" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- QR Manager -->
            <LinearLayout android:id="@+id/rowQrManager"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:background="@color/bg_card" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:layout_marginTop="2dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_qr_manager"
                        android:textColor="@color/text_primary" android:textSize="16sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_qr_manager_desc"
                        android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/text_secondary" android:textSize="24sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
