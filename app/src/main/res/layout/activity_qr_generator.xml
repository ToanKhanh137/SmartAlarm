<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/bg_primary"
        app:navigationIcon="@drawable/ic_dismiss" android:title="@string/qr_generator_title"
        app:titleTextColor="@color/text_primary"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp" android:gravity="center">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/qr_print_hint" android:textColor="@color/text_secondary"
                android:textSize="14sp" android:gravity="center" android:layout_marginBottom="32dp"
                android:lineSpacingMultiplier="1.3"/>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="@android:color/white"
                app:cardElevation="4dp" android:layout_marginBottom="32dp">
                <ImageView android:id="@+id/ivQrCode" android:layout_width="250dp"
                    android:layout_height="250dp" android:padding="16dp"
                    android:scaleType="fitCenter"/>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/qr_generate" android:textColor="@color/text_primary"
                app:strokeColor="@color/border" android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="@string/qr_save_gallery"
                android:backgroundTint="@color/accent" android:textColor="@color/text_on_accent"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
