<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ring_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/challenge_qr"
        android:textColor="@color/challenge_qr"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.14"
        android:gravity="center"
        android:paddingTop="32dp"/>

    <TextView android:id="@+id/tvInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:paddingHorizontal="28dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"/>

    <!-- Khung quét -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcodeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Hiện khi chưa có quyền camera: thay cho màn hình đen không giải thích gì -->
        <LinearLayout android:id="@+id/llPermission"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/ring_bg"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_camera_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_camera_message"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/perm_open_settings"
                android:textColor="@color/text_on_accent"
                android:backgroundTint="@color/accent"
                app:cornerRadius="26dp"/>
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_challenge_skip"/>

    <Space android:layout_width="match_parent" android:layout_height="12dp"/>
</LinearLayout>
